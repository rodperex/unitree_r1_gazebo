<?xml version="1.0"?>
<!-- A hospital room of 6 x 5 m: a bed, a bedside table, an IV stand, a visitor chair and a cart (Gazebo Fuel); the robot starts by the door, facing the bed (unitree_r1_gazebo). Processed by xacro with the argument headless: with the Gazebo
     window the floor shows a grid. Models from Gazebo Fuel are downloaded the first time. -->
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="headless" default="true"/>
  <world name="hospital_room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <grid>${'false' if '$(arg headless)' in ('True', 'true') else 'true'}</grid>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.78 1</ambient><diffuse>0.8 0.8 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="room_walls">
      <static>true</static>
      <link name="wall_0">
        <pose>1.500 -2.500 1.25 0 0 0.0000</pose>
        <collision name="c"><geometry><box><size>6.000 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.000 0.1 2.5</size></box></geometry><material><ambient>0.85 0.92 0.95 1</ambient><diffuse>0.85 0.92 0.95 1</diffuse></material></visual>
      </link>
      <link name="wall_1">
        <pose>4.500 0.000 1.25 0 0 1.5708</pose>
        <collision name="c"><geometry><box><size>5.000 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5.000 0.1 2.5</size></box></geometry><material><ambient>0.85 0.92 0.95 1</ambient><diffuse>0.85 0.92 0.95 1</diffuse></material></visual>
      </link>
      <link name="wall_2">
        <pose>1.500 2.500 1.25 0 0 3.1416</pose>
        <collision name="c"><geometry><box><size>6.000 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.000 0.1 2.5</size></box></geometry><material><ambient>0.85 0.92 0.95 1</ambient><diffuse>0.85 0.92 0.95 1</diffuse></material></visual>
      </link>
      <link name="wall_3">
        <pose>-1.500 1.550 1.25 0 0 -1.5708</pose>
        <collision name="c"><geometry><box><size>1.900 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.900 0.1 2.5</size></box></geometry><material><ambient>0.85 0.92 0.95 1</ambient><diffuse>0.85 0.92 0.95 1</diffuse></material></visual>
      </link>
      <link name="wall_4">
        <pose>-1.500 -1.550 1.25 0 0 -1.5708</pose>
        <collision name="c"><geometry><box><size>1.900 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.900 0.1 2.5</size></box></geometry><material><ambient>0.85 0.92 0.95 1</ambient><diffuse>0.85 0.92 0.95 1</diffuse></material></visual>
      </link>
    </model>
    <include>
      <name>bed</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/CGMClassic</uri>
      <pose>3.3 0.0 0.0 0 0 3.1416</pose>
    </include>
    <include>
      <name>bedside_table</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/BedsideTable</uri>
      <pose>3.6 1.4 0.0 0 0 0.0000</pose>
    </include>
    <include>
      <name>iv_stand</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/IVStand</uri>
      <pose>3.6 -1.4 0.0 0 0 0.0000</pose>
    </include>
    <include>
      <name>visitor_chair</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/VisitorChair</uri>
      <pose>2.0 1.9 0.0 0 0 -1.5708</pose>
    </include>
    <include>
      <name>cart</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/BPCart</uri>
      <pose>0.5 -2.1 0.0 0 0 0.0000</pose>
    </include>
  </world>
</sdf>
