<?xml version="1.0"?>
<!-- A house of 9 x 7 m: a living room (where the robot starts, facing the kitchen), a kitchen-dining room and a bedroom, with furniture of Gazebo Fuel (unitree_r1_gazebo). Processed by xacro with the argument headless: with the Gazebo
     window the floor shows a grid. Models from Gazebo Fuel are downloaded the first time. -->
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="headless" default="true"/>
  <world name="house">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <grid>${'false' if '$(arg headless)' in ('True', 'true') else 'true'}</grid>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.75 0.65 0.5 1</ambient><diffuse>0.75 0.65 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="house_walls">
      <static>true</static>
      <link name="wall_0">
        <pose>2.500 -3.500 1.25 0 0 0.0000</pose>
        <collision name="c"><geometry><box><size>9.000 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>9.000 0.1 2.5</size></box></geometry><material><ambient>0.92 0.90 0.85 1</ambient><diffuse>0.92 0.90 0.85 1</diffuse></material></visual>
      </link>
      <link name="wall_1">
        <pose>7.000 0.000 1.25 0 0 1.5708</pose>
        <collision name="c"><geometry><box><size>7.000 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7.000 0.1 2.5</size></box></geometry><material><ambient>0.92 0.90 0.85 1</ambient><diffuse>0.92 0.90 0.85 1</diffuse></material></visual>
      </link>
      <link name="wall_2">
        <pose>2.500 3.500 1.25 0 0 3.1416</pose>
        <collision name="c"><geometry><box><size>9.000 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>9.000 0.1 2.5</size></box></geometry><material><ambient>0.92 0.90 0.85 1</ambient><diffuse>0.92 0.90 0.85 1</diffuse></material></visual>
      </link>
      <link name="wall_3">
        <pose>-2.000 0.000 1.25 0 0 -1.5708</pose>
        <collision name="c"><geometry><box><size>7.000 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7.000 0.1 2.5</size></box></geometry><material><ambient>0.92 0.90 0.85 1</ambient><diffuse>0.92 0.90 0.85 1</diffuse></material></visual>
      </link>
      <link name="wall_4">
        <pose>-0.750 -1.500 1.25 0 0 0.0000</pose>
        <collision name="c"><geometry><box><size>2.500 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.500 0.1 2.5</size></box></geometry><material><ambient>0.92 0.90 0.85 1</ambient><diffuse>0.92 0.90 0.85 1</diffuse></material></visual>
      </link>
      <link name="wall_5">
        <pose>4.250 -1.500 1.25 0 0 0.0000</pose>
        <collision name="c"><geometry><box><size>5.500 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5.500 0.1 2.5</size></box></geometry><material><ambient>0.92 0.90 0.85 1</ambient><diffuse>0.92 0.90 0.85 1</diffuse></material></visual>
      </link>
      <link name="wall_6">
        <pose>3.500 -0.500 1.25 0 0 1.5708</pose>
        <collision name="c"><geometry><box><size>2.000 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.000 0.1 2.5</size></box></geometry><material><ambient>0.92 0.90 0.85 1</ambient><diffuse>0.92 0.90 0.85 1</diffuse></material></visual>
      </link>
      <link name="wall_7">
        <pose>3.500 2.750 1.25 0 0 1.5708</pose>
        <collision name="c"><geometry><box><size>1.500 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.500 0.1 2.5</size></box></geometry><material><ambient>0.92 0.90 0.85 1</ambient><diffuse>0.92 0.90 0.85 1</diffuse></material></visual>
      </link>
    </model>
    <include>
      <name>sofa</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sofa</uri>
      <pose>-1.4 1.0 0.0 0 0 -1.5708</pose>
    </include>
    <include>
      <name>coffee_table</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/CoffeeTable</uri>
      <pose>-0.5 1.0 0.0 0 0 0.0000</pose>
    </include>
    <include>
      <name>tv_stand</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/TVStand</uri>
      <pose>1.2 3.2 0.0 0 0 3.1416</pose>
    </include>
    <include>
      <name>bookshelf</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Bookshelf</uri>
      <pose>2.5 3.2 0.0 0 0 3.1416</pose>
    </include>
    <include>
      <name>lamp</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/LampAndStand</uri>
      <pose>-1.6 2.8 0.0 0 0 0.0000</pose>
    </include>
    <include>
      <name>kitchen_counter</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/KitchenCountertop</uri>
      <pose>6.6 2.0 0.0 0 0 -1.5708</pose>
    </include>
    <include>
      <name>fridge</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Refrigerator</uri>
      <pose>6.6 3.0 0.0 0 0 -1.5708</pose>
    </include>
    <include>
      <name>dining_table</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Table</uri>
      <pose>5.2 -0.3 0.0 0 0 0.0000</pose>
    </include>
    <include>
      <name>dining_chair_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/WoodenChair</uri>
      <pose>5.2 0.5 0.0 0 0 -1.5708</pose>
    </include>
    <include>
      <name>dining_chair_2</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/WoodenChair</uri>
      <pose>5.2 -1.1 0.0 0 0 1.5708</pose>
    </include>
    <include>
      <name>bed</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Bed</uri>
      <pose>-0.8 -2.6 0.0 0 0 0.0000</pose>
    </include>
    <include>
      <name>bedside_table</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/BedsideTable</uri>
      <pose>0.6 -3.1 0.0 0 0 0.0000</pose>
    </include>
  </world>
</sdf>
