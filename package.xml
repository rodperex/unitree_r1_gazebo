<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>unitree_r1_gazebo</name>
  <version>0.1.0</version>
  <description>
    The Unitree R1 humanoid in Gazebo (Harmonic), driven as the real robot through unitree_sdk2:
    an emulation of its firmware (the locomotion service, the arm SDK, the low-level state and
    the odometry), its state in ROS, and worlds to put it in (an empty one, a warehouse, a house,
    a hospital room).
  </description>
  <maintainer email="rodrigo.perez@urjc.es">Rodrigo Pérez-Rodríguez</maintainer>
  <license>Apache-2.0</license>
  <author email="rodrigo.perez@urjc.es">Rodrigo Pérez-Rodríguez</author>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- unitree_sdk2_python and its CycloneDDS binding are not rosdep keys: see the README -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
